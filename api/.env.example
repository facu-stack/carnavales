DATABASE_URL=postgres://postgres:your-password@localhost:5432/carnavales_dev
BETTER_AUTH_SECRET=change-this-to-a-long-random-string-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
# EMAIL_PROVIDER=console en desarrollo (imprime el PIN en la consola) o smtp en producción.
# Para Gmail real: EMAIL_PROVIDER=smtp y completar SMTP_USER/SMTP_PASSWORD con una
# contraseña de aplicación. Nunca subir credenciales a Git.
# Ojo: `npm test` fuerza EMAIL_PROVIDER=console para poder capturar el PIN en los tests.
EMAIL_PROVIDER=smtp
EMAIL_FROM=modobetatestsnoreply@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=modobetatestsnoreply@gmail.com
SMTP_PASSWORD=your-gmail-app-password
PASSWORD_RESET_TOKEN_TTL=1800
NODE_ENV=development
PORT=3000